{
  "name": "admin",
  "private": true,
  "version": "1.0.4",
  "description": "Panel de administración RepuestosYa con gestión de impresoras 3D Bambu Lab",
  "author": "TIZIANO",
  "main": "src-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite dev\" \"cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && dotenv -e .env -- electron-builder --win --publish always",
    "lint": "oxlint"
  },
  "dependencies": {
    "@boxicons/react": "^1.0.3",
    "@repuestos-ya/supabase": "workspace:*",
    "@repuestos-ya/ui": "workspace:*",
    "electron-updater": "^6.8.11",
    "mqtt": "^5.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@repuestos-ya/config": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.11",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.repuestosya.admin",
    "productName": "RepuestosYa",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "roloar7",
      "repo": "RepuestosYa",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": null,
    "linux": null
  }
}